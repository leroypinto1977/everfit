# Copy to apps/admin/.env.production ON THE SERVER. Never commit the real one.
#
#   install -m 600 deploy/env/admin.env.production.example apps/admin/.env.production
#   nano apps/admin/.env.production
#   npm run check-env:admin
#
# This is the file whose absence caused "environment variables not present in
# the admin application": the panel was split out of the storefront after the
# variables were first configured, so it inherited only DATABASE_URL and
# ADMIN_KEY. Everything below is read by admin code and must be set here too —
# the two deployments do not share an environment.
#
# Do NOT create the apps/admin/.env.local symlink on the server; it is the
# development file and takes precedence over this one.

# ── Database ───────────────────────────────────────────────────────────────
# Byte-identical to the storefront's — one database serves both apps.
DATABASE_URL=

# ── Admin access ───────────────────────────────────────────────────────────
# One-time secret used on the first visit to /login to create the owner
# account. Inert afterwards, but keep it long and random until then.
ADMIN_KEY=

# ── Razorpay ───────────────────────────────────────────────────────────────
# The panel needs these for refunds, so the same live keys as the storefront.
# RAZORPAY_WEBHOOK_SECRET and CRON_SECRET are storefront-only — leave them out.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── URLs ───────────────────────────────────────────────────────────────────
# Build-time: a rebuild is required after changing NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_SITE_URL=https://evherfit.com
ADMIN_URL=https://admin.evherfit.com
STORE_URL=https://evherfit.com

# Must be byte-identical to the storefront's value, or every catalogue edit
# gets a silent 401 from the storefront and prices go stale.
REVALIDATE_SECRET=

# ── Transactional email (Brevo) ────────────────────────────────────────────
# The panel sends shipping, delivery, refund, teammate-welcome and
# password-reset email — without these, "Mark as shipped" tells nobody.
BREVO_API_KEY=
EMAIL_FROM="EVHERFIT <orders@evherfit.com>"
SUPPORT_EMAIL=info@evherfit.com
ORDER_NOTIFY_EMAIL=

# ── Invoicing & reporting ──────────────────────────────────────────────────
REPORT_TIMEZONE=Asia/Kolkata
GST_RATE=0.18
# Required for a compliant tax invoice: STORE_STATE decides CGST+SGST vs IGST.
STORE_STATE=
STORE_GSTIN=
HSN_CODE=9506
# Return address printed on shipping labels.
STORE_ADDRESS=
