# Copy to apps/store/.env.production ON THE SERVER. Never commit the real one.
#
#   install -m 600 deploy/env/store.env.production.example apps/store/.env.production
#   nano apps/store/.env.production
#   npm run check-env:store
#
# Precedence reminder (Next.js): process.env > .env.production.local >
# .env.local > .env.production > .env. Do NOT create the apps/store/.env.local
# symlink on the server — it is the development file and would silently
# override everything below.

# ── Database ───────────────────────────────────────────────────────────────
# Same database as the admin panel. Neon needs sslmode=require.
DATABASE_URL=

# ── Razorpay ───────────────────────────────────────────────────────────────
# LIVE keys here (rzp_live_…), test keys only on a staging host.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Dashboard → Settings → Webhooks
#   URL     https://evherfit.com/api/webhooks/razorpay
#   Events  payment.captured, payment.failed, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=

# Bearer token the reconcile cron presents. Must match deploy/cron/reconcile.sh
# (which reads it from this same file, so just set it once here).
CRON_SECRET=

# ── URLs ───────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* is inlined into the client bundle by `next build`. Changing it
# needs a REBUILD, not just a `pm2 restart`.
NEXT_PUBLIC_SITE_URL=https://evherfit.com
ADMIN_URL=https://admin.evherfit.com

# Must be byte-identical to the admin panel's value.
REVALIDATE_SECRET=

# ── Transactional email (Brevo) ────────────────────────────────────────────
BREVO_API_KEY=
EMAIL_FROM="EVHERFIT <orders@evherfit.com>"
SUPPORT_EMAIL=info@evherfit.com
ORDER_NOTIFY_EMAIL=
# BREVO_LIST_ID=2

# ── Analytics ──────────────────────────────────────────────────────────────
# Also build-time. GA4, Search Console and Clarity go inside this container.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
