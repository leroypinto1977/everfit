{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "store",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/store", "run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "//": "Production build of the storefront — what perf work must be measured against; `npm run build` first.",
      "name": "store-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/store", "run", "start", "--", "-p", "3100"],
      "port": 3100
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/admin", "run", "dev:port"],
      "port": 3001,
      "autoPort": true
    }
  ]
}
