{
  "name": "everfit",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "//": "The --workspace flag must come BEFORE the script name: `npm run build --workspace=X` makes npm treat the flag as a script argument and re-run this root script forever.",
    "dev": "npm run --workspace=@everfit/store dev",
    "dev:admin": "npm run --workspace=@everfit/admin dev",
    "build": "npm run --workspace=@everfit/store build",
    "build:admin": "npm run --workspace=@everfit/admin build",
    "start": "npm run --workspace=@everfit/store start",
    "start:admin": "npm run --workspace=@everfit/admin start",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "tsc -p apps/store --noEmit && tsc -p apps/admin --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node scripts/seed-orders.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "devDependencies": {
    "@types/node": "^20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
