{
  "name": "everfit",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "//": "Delegate to a workspace with `npm --prefix <dir> run <script>`, never with --workspace. Inside a lifecycle script npm ignores --workspace in either position and re-runs this root script forever.",
    "dev": "npm --prefix apps/store run dev",
    "dev:admin": "npm --prefix apps/admin run dev",
    "build": "npm --prefix apps/store run build",
    "build:admin": "npm --prefix apps/admin run build",
    "start": "npm --prefix apps/store run start",
    "start:admin": "npm --prefix apps/admin run start",
    "lint": "npm --prefix apps/store run lint && npm --prefix apps/admin run lint",
    "typecheck": "tsc -p apps/store --noEmit && tsc -p apps/admin --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node scripts/seed-orders.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "devDependencies": {
    "@types/node": "^20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
